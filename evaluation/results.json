{
  "project": "intro-deep-learning-starter",
  "evaluation_version": "1.2",
  "evaluation_type": "portfolio_project",

  "scope": {
    "notebook": "notebooks/intro_to_deep_learning.ipynb",
    "tasks": [
      "regression",
      "binary_classification",
      "overfitting_analysis",
      "regularization_comparison"
    ]
  },

  "methodology": {
    "regression_dataset": "sklearn.datasets.load_diabetes",
    "classification_dataset": "sklearn.datasets.load_breast_cancer",
    "framework": "TensorFlow/Keras",
    "random_state": 0,
    "preprocessing": "StandardScaler fitted only on training data"
  },

  "evaluation": {
    "cross_validation": {
      "status": "implemented",
      "regression": "5-fold KFold",
      "classification": "5-fold StratifiedKFold",
      "reports": [
        "mean",
        "standard_deviation"
      ]
    },

    "held_out_test": {
      "status": "implemented",
      "test_size": 0.2,
      "random_state": 0,
      "test_set_used_for_model_selection": false,
      "regression_metrics": [
        "MAE",
        "RMSE",
        "R2"
      ],
      "classification_metrics": [
        "accuracy",
        "precision",
        "recall",
        "F1",
        "ROC-AUC"
      ]
    }
  },

  "automation": {
    "unit_tests": {
      "status": "implemented",
      "command": "pytest -q"
    },

    "notebook_smoke_test": {
      "status": "implemented",
      "tool": "jupyter nbconvert",
      "timeout_seconds": 600
    },

    "continuous_integration": {
      "status": "implemented",
      "workflow": ".github/workflows/ci.yml",
      "triggers": [
        "push to main",
        "pull_request to main"
      ]
    }
  },

  "quality_checks": {
    "data_leakage": "pass",
    "reproducibility": "pass",
    "early_stopping": "pass",
    "model_comparison": "pass",
    "unit_tests": "implemented",
    "notebook_execution": "implemented",
    "independent_test_set": "implemented"
  },

  "limitations": [
    "The datasets are small and come from scikit-learn.",
    "Hyperparameter search is limited.",
    "The project focuses on educational deep-learning fundamentals rather than production deployment.",
    "No external benchmark is included."
  ],

  "portfolio_assessment": {
    "technical_depth": "strong deep-learning fundamentals",
