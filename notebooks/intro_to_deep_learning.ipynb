import json
from pathlib import Path

notebook = {
    "cells": [
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "# Intro to Deep Learning — TensorFlow & Keras on Structured Data\n",
                "\n",
                "Companion notebook for the Kaggle Learn **Intro to Deep Learning** course, rebuilt end-to-end with `tf.keras` on structured data from scikit-learn.\n",
                "\n",
                "## Datasets\n",
                "\n",
                "- **Regression** — `sklearn.datasets.load_diabetes`\n",
                "- **Binary classification** — `sklearn.datasets.load_breast_cancer`\n",
                "\n",
                "## Sections\n",
                "\n",
                "| # | Section |\n",
                "|---|---|\n",
                "| 1 | A Single Neuron |\n",
                "| 2 | Deep Neural Networks |\n",
                "| 3 | Stochastic Gradient Descent |\n",
                "| 4 | Overfitting and Underfitting |\n",
                "| 5 | Dropout and Batch Normalization |\n",
                "| 6 | Binary Classification |\n",
                "| 7 | Results Summary |\n",
            ],
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": ["## Setup"],
        },
        {
            "cell_type": "code",
            "execution_count": None,
            "metadata": {},
            "outputs": [],
            "source": [
                "import numpy as np\n",
                "import pandas as pd\n",
                "import matplotlib.pyplot as plt\n",
                "\n",
                "from sklearn.datasets import load_diabetes, load_breast_cancer\n",
                "from sklearn.model_selection import train_test_split\n",
                "from sklearn.preprocessing import StandardScaler\n",
                "from sklearn.metrics import (\n",
                "    mean_squared_error,\n",
                "    r2_score,\n",
                "    confusion_matrix,\n",
                "    classification_report,\n",
                "    roc_auc_score,\n",
                ")\n",
                "\n",
                "import tensorflow as tf\n",
                "from tensorflow import keras\n",
                "from tensorflow.keras import layers\n",
                "\n",
                "%matplotlib inline\n",
                "plt.rcParams['figure.figsize'] = (8, 5)\n",
                "\n",
                "RANDOM_STATE = 0\n",
                "tf.random.set_seed(RANDOM_STATE)\n",
            ],
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 1. A Single Neuron\n",
                "\n",
                "A single `Dense(1)` layer without activation is the neural-network equivalent of linear regression.",
            ],
        },
        {
            "cell_type": "code",
            "execution_count": None,
            "metadata": {},
            "outputs": [],
            "source": [
                "diabetes = load_diabetes()\n",
                "X, y = diabetes.data, diabetes.target\n",
                "\n",
                "X_train, X_valid, y_train, y_valid = train_test_split(\n",
                "    X, y, test_size=0.2, random_state=RANDOM_STATE\n",
                ")\n",
                "\n",
                "scaler = StandardScaler()\n",
                "X_train_s = scaler.fit_transform(X_train)\n",
                "X_valid_s = scaler.transform(X_valid)\n",
                "\n",
                "single_neuron = keras.Sequential([\n",
                "    layers.Input(shape=[X_train_s.shape[1]]),\n",
                "    layers.Dense(1),\n",
                "])\n",
                "single_neuron.compile(optimizer='adam', loss='mae')\n",
                "\n",
                "history_single = single_neuron.fit(\n",
                "    X_train_s, y_train,\n",
                "    validation_data=(X_valid_s, y_valid),\n",
                "    epochs=10,\n",
                "    verbose=0,\n",
                ")\n",
                "\n",
                "print(f\"Single neuron — final validation MAE: {history_single.history['val_loss'][-1]:.2f}\")\n",
            ],
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 2. Deep Neural Networks\n",
                "\n",
                "Stacking dense layers with `relu` lets the network model nonlinear relationships.",
            ],
        },
        {
            "cell_type": "code",
            "execution_count": None,
            "metadata": {},
            "outputs": [],
            "source": [
                "dnn = keras.Sequential([\n",
                "    layers.Input(shape=[X_train_s.shape[1]]),\n",
                "    layers.Dense(64, activation='relu'),\n",
                "    layers.Dense(64, activation='relu'),\n",
                "    layers.Dense(1),\n",
                "])\n",
                "dnn.compile(optimizer='adam', loss='mae')\n",
                "\n",
                "history_dnn = dnn.fit(\n",
                "    X_train_s, y_train,\n",
                "    validation_data=(X_valid_s, y_valid),\n",
                "    epochs=50,\n",
                "    verbose=0,\n",
                ")\n",
                "\n",
                "print(f\"Deep network   — final validation MAE: {history_dnn.history['val_loss'][-1]:.2f}\")\n",
                "print(f\"Single neuron  — final validation MAE: {history_single.history['val_loss'][-1]:.2f}\")\n",
            ],
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 3. Stochastic Gradient Descent\n",
                "\n",
                "Training is `optimizer` + `loss` working together. Here the batch size and learning rate are explicit.",
            ],
        },
        {
            "cell_type": "code",
            "execution_count": None,
            "metadata": {},
            "outputs": [],
            "source": [
                "sgd_model = keras.Sequential([\n",
                "    layers.Input(shape=[X_train_s.shape[1]]),\n",
                "    layers.Dense(32, activation='relu'),\n",
                "    layers.Dense(1),\n",
                "])\n",
                "sgd_model.compile(optimizer=keras.optimizers.SGD(learning_rate=0.01), loss='mae')\n",
                "\n",
                "history_sgd = sgd_model.fit(\n",
                "    X_train_s, y_train,\n",
                "    validation_data=(X_valid_s, y_valid),\n",
                "    epochs=50,\n",
                "    batch_size=32,\n",
                "    verbose=0,\n",
                ")\n",
                "\n",
                "pd.DataFrame(history_sgd.history)[['loss', 'val_loss']].plot(title='SGD loss curve')\n",
                "plt.xlabel('Epoch')\n",
                "plt.ylabel('MAE')\n",
                "plt.show()\n",
            ],
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 4. Overfitting and Underfitting\n",
                "\n",
                "A larger network can overfit if it trains too long. `EarlyStopping` helps stop at the best validation point.",
            ],
        },
        {
            "cell_type": "code",
            "execution_count": None,
            "metadata": {},
            "outputs": [],
            "source": [
                "overfit_model = keras.Sequential([\n",
                "    layers.Input(shape=[X_train_s.shape[1]]),\n",
                "    layers.Dense(256, activation='relu'),\n",
                "    layers.Dense(256, activation='relu'),\n",
                "    layers.Dense(1),\n",
                "])\n",
                "overfit_model.compile(optimizer='adam', loss='mae')\n",
                "\n",
                "early_stopping = keras.callbacks.EarlyStopping(\n",
                "    min_delta=0.001,\n",
                "    patience=10,\n",
                "    restore_best_weights=True,\n",
                ")\n",
                "\n",
                "history_es = overfit_model.fit(\n",
                "    X_train_s, y_train,\n",
                "    validation_data=(X_valid_s, y_valid),\n",
                "    epochs=200,\n",
                "    callbacks=[early_stopping],\n",
                "    verbose=0,\n",
                ")\n",
                "\n",
                "pd.DataFrame(history_es.history)[['loss', 'val_loss']].plot(title='Overfitting + EarlyStopping')\n",
                "plt.xlabel('Epoch')\n",
                "plt.ylabel('MAE')\n",
                "plt.show()\n",
                "\n",
                "print(f\"Stopped after {len(history_es.history['loss'])} epochs\")\n",
            ],
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 5. Dropout and Batch Normalization\n",
                "\n",
                "Dropout reduces overfitting directly. Batch Normalization can help too, but its effect is dataset-dependent.",
            ],
        },
        {
            "cell_type": "code",
            "execution_count": None,
            "metadata": {},
            "outputs": [],
            "source": [
                "dropout_model = keras.Sequential([\n",
                "    layers.Input(shape=[X_train_s.shape[1]]),\n",
                "    layers.Dense(256, activation='relu'),\n",
                "    layers.Dropout(0.3),\n",
                "    layers.Dense(256, activation='relu'),\n",
                "    layers.Dropout(0.3),\n",
                "    layers.Dense(1),\n",
                "])\n",
                "dropout_model.compile(optimizer='adam', loss='mae')\n",
                "\n",
                "history_dropout = dropout_model.fit(\n",
                "    X_train_s, y_train,\n",
                "    validation_data=(X_valid_s, y_valid),\n",
                "    epochs=150,\n",
                "    verbose=0,\n",
                ")\n",
                "\n",
                "dropout_bn_model = keras.Sequential([\n",
                "    layers.Input(shape=[X_train_s.shape[1]]),\n",
                "    layers.Dense(256, activation='relu'),\n",
                "    layers.BatchNormalization(),\n",
                "    layers.Dropout(0.3),\n",
                "    layers.Dense(256, activation='relu'),\n",
                "    layers.BatchNormalization(),\n",
                "    layers.Dropout(0.3),\n",
                "    layers.Dense(1),\n",
                "])\n",
                "dropout_bn_model.compile(optimizer='adam', loss='mae')\n",
                "\n",
                "history_dropout_bn = dropout_bn_model.fit(\n",
                "    X_train_s, y_train,\n",
                "    validation_data=(X_valid_s, y_valid),\n",
                "    epochs=150,\n",
                "    verbose=0,\n",
                ")\n",
                "\n",
                "def last10_gap(history):\n",
                "    train = np.mean(history.history['loss'][-10:])\n",
                "    valid = np.mean(history.history['val_loss'][-10:])\n",
                "    return train, valid, valid - train\n",
                "\n",
                "t0, v0, g0 = last10_gap(history_dropout)\n",
                "t1, v1, g1 = last10_gap(history_dropout_bn)\n",
                "\n",
                "print(f\"Dropout only  — train {t0:.1f} / val {v0:.1f} / gap {g0:.1f}\")\n",
                "print(f\"Dropout + BN  — train {t1:.1f} / val {v1:.1f} / gap {g1:.1f}\")\n",
            ],
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 6. Binary Classification\n",
                "\n",
                "A sigmoid output with binary cross-entropy is the standard setup for binary classification.",
            ],
        },
        {
            "cell_type": "code",
            "execution_count": None,
            "metadata": {},
            "outputs": [],
            "source": [
                "cancer = load_breast_cancer()\n",
                "Xc, yc = cancer.data, cancer.target\n",
                "\n",
                "Xc_train, Xc_valid, yc_train, yc_valid = train_test_split(\n",
                "    Xc, yc, test_size=0.2, random_state=RANDOM_STATE, stratify=yc\n",
                ")\n",
                "\n",
                "scaler_c = StandardScaler()\n",
                "Xc_train_s = scaler_c.fit_transform(Xc_train)\n",
                "Xc_valid_s = scaler_c.transform(Xc_valid)\n",
                "\n",
                "clf_model = keras.Sequential([\n",
                "    layers.Input(shape=[Xc_train_s.shape[1]]),\n",
                "    layers.Dense(32, activation='relu'),\n",
                "    layers.Dropout(0.3),\n",
                "    layers.Dense(1, activation='sigmoid'),\n",
                "])\n",
                "\n",
                "clf_model.compile(\n",
                "    optimizer='adam',\n",
                "    loss='binary_crossentropy',\n",
                "    metrics=['binary_accuracy'],\n",
                ")\n",
                "\n",
                "history_clf = clf_model.fit(\n",
                "    Xc_train_s, yc_train,\n",
                "    validation_data=(Xc_valid_s, yc_valid),\n",
                "    batch_size=32,\n",
                "    epochs=50,\n",
                "    callbacks=[\n",
                "        keras.callbacks.EarlyStopping(\n",
                "            min_delta=0.001,\n",
                "            patience=5,\n",
                "            restore_best_weights=True,\n",
                "        )\n",
                "    ],\n",
                "    verbose=0,\n",
                ")\n",
                "\n",
                "best_val_acc = max(history_clf.history['val_binary_accuracy'])\n",
                "print(f\"Best validation accuracy: {best_val_acc:.1%}\")\n",
            ],
        },
        {
            "cell_type": "markdown",
            "metadata": {},
            "source": [
                "## 7. Results Summary\n",
                "\n",
                "A compact summary helps compare the models side by side.",
            ],
        },
        {
            "cell_type": "code",
            "execution_count": None,
            "metadata": {},
            "outputs": [],
            "source": [
                "# Regression summary\n",
                "y_pred_reg = dnn.predict(X_valid_s, verbose=0).squeeze()\n",
                "mae = np.mean(np.abs(y_valid - y_pred_reg))\n",
                "rmse = np.sqrt(mean_squared_error(y_valid, y_pred_reg))\n",
                "r2 = r2_score(y_valid, y_pred_reg)\n",
                "\n",
                "regression_summary = pd.DataFrame(\n",
                "    {\n",
                "        'Metric': ['MAE', 'RMSE', 'R²'],\n",
                "        'Value': [f'{mae:.2f}', f'{rmse:.2f}', f'{r2:.3f}'],\n",
                "    }\n",
                ")\n",
                "\n",
                "# Classification summary\n",
                "y_prob = clf_model.predict(Xc_valid_s, verbose=0).squeeze()\n",
                "y_pred = (y_prob >= 0.5).astype(int)\n",
                "\n",
                "cm = confusion_matrix(yc_valid, y_pred)\n",
                "report = classification_report(yc_valid, y_pred, digits=3, output_dict=True)\n",
                "roc_auc = roc_auc_score(yc_valid, y_prob)\n",
                "\n",
                "classification_summary = pd.DataFrame(\n",
                "    {\n",
                "        'Metric': [\n",
                "            'Accuracy',\n",
                "            'Precision (class 1)',\n",
                "            'Recall (class 1)',\n",
                "            'F1-score (class 1)',\n",
                "            'ROC-AUC',\n",
                "        ],\n",
                "        'Value': [\n",
                "            f\"{report['accuracy']:.3f}\",\n",
                "            f\"{report['1']['precision']:.3f}\",\n",
                "            f\"{report['1']['recall']:.3f}\",\n",
                "            f\"{report['1']['f1-score']:.3f}\",\n",
                "            f\"{roc_auc:.3f}\",\n",
                "        ],\n",
                "    }\n",
                ")\n",
                "\n",
                "print('Regression summary')\n",
                "display(regression_summary)\n",
                "\n",
                "print('\\nClassification summary')\n",
                "display(classification_summary)\n",
                "\n",
                "print('\\nConfusion matrix')\n",
                "print(cm)\n",
            ],
        },
    ],
